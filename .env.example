# ===== Supabase =====
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (server-side only, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== App =====
NEXT_PUBLIC_APP_NAME=ConnectDirectory
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Google OAuth (optional, configured in Supabase) =====
# These are configured in Supabase Dashboard > Authentication > Providers > Google
# No keys needed in the app itself.
